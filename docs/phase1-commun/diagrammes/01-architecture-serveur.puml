@startuml
skinparam componentStyle rectangle
skinparam defaultFontSize 12

title Architecture du Serveur C

package "Serveur C" {
  [main.c\nBoucle principale]
  [network.c\nSocket + Bind + Listen]
  [client_handler.c\n1 thread par client]

  package "Metier" {
    [carte.c]
    [battle.c]
    [legitimation.c]
  }

  package "Technique" {
    [blockchain.c\nSHA-256 + PoW]
    [db.c\nPostgreSQL]
    [protocol.c\nParse JSON]
    [utils.c]
  }
}

database "PostgreSQL" as DB

[main.c\nBoucle principale] --> [network.c\nSocket + Bind + Listen]
[network.c\nSocket + Bind + Listen] --> [client_handler.c\n1 thread par client]
[client_handler.c\n1 thread par client] --> [protocol.c\nParse JSON]
[protocol.c\nParse JSON] --> [carte.c]
[protocol.c\nParse JSON] --> [battle.c]
[protocol.c\nParse JSON] --> [legitimation.c]
[carte.c] --> [blockchain.c\nSHA-256 + PoW]
[battle.c] --> [blockchain.c\nSHA-256 + PoW]
[legitimation.c] --> [blockchain.c\nSHA-256 + PoW]
[blockchain.c\nSHA-256 + PoW] --> [db.c\nPostgreSQL]
[db.c\nPostgreSQL] --> DB

@enduml
