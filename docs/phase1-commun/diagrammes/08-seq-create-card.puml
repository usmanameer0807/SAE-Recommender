@startuml

title Sequence CREATE_CARD - Creation d'une carte langage

actor Utilisateur
participant "CardController" as CC
participant "NetworkClient" as NC
participant "Socket TCP" as S
participant "Serveur C" as SC

Utilisateur -> CC : remplit le formulaire
Utilisateur -> CC : clic Creer

CC -> CC : validation des champs

alt donnees valides
    CC -> NC : send CREATE_CARD
    NC -> S : envoi JSON
    S -> SC : {"action":"CREATE_CARD","payload":{"title":"Python","paradigm":"MULTI","typing":"DYNAMIC","difficulty":"BEGINNER","yearCreated":1991}}

    SC -> SC : verifie les donnees
    SC -> SC : genere card_id
    SC -> SC : mine un bloc SHA-256

    SC -> S : {"status":"OK","action":"CARD_CREATED","data":{"cardId":"c_001"}}
    S -> NC : ligne JSON
    NC -> CC : callback
    CC -> CC : Platform.runLater
    CC -> Utilisateur : Affichage de la nouvelle carte

    SC -> S : {"status":"NOTIFY","action":"NEW_CARD"}
    S -> SC : broadcast aux autres clients

else donnees invalides
    SC -> S : {"status":"ERROR","code":"INVALID_DATA"}
    S -> NC : ligne JSON
    NC -> CC : callback
    CC -> Utilisateur : Message d'erreur
end

@enduml
