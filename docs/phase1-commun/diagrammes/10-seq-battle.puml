@startuml

title Sequence BATTLE - Lancer, voter, resultat

actor "Utilisateur A" as U1
actor "Utilisateur B" as U2
participant "BattleController" as BC
participant "NetworkClient" as NC
participant "Socket TCP" as S
participant "Serveur C" as SC
participant "Autres clients" as AC

== Phase 1 : Lancer battle ==

U1 -> BC : clic Lancer battle
BC -> NC : send START_BATTLE
NC -> S : envoi JSON
S -> SC : {"action":"START_BATTLE","payload":{"cardId1":"c_001","cardId2":"c_005"}}

SC -> SC : verifie cartes ACTIVE
SC -> SC : verifie meme paradigm
SC -> SC : verifie VA >= 5
SC -> SC : verifie 1 seule battle active
SC -> SC : mine un bloc

alt battle acceptee
    SC -> S : {"status":"OK","action":"BATTLE_STARTED","data":{"battleId":"b_014","duration":60}}
    SC -> AC : {"status":"NOTIFY","action":"NEW_BATTLE"}
    S -> NC : ligne JSON
    NC -> BC : callback
    BC -> U1 : Affichage de la battle

else cartes non comparables
    SC -> S : {"status":"ERROR","code":"CARDS_NOT_COMPATIBLE"}
    S -> NC : ligne JSON
    NC -> BC : callback
    BC -> U1 : Message d'erreur
end

== Phase 2 : Voter ==

U2 -> BC : clic Voter
BC -> NC : send VOTE_BATTLE
NC -> S : envoi JSON
S -> SC : {"action":"VOTE_BATTLE","payload":{"battleId":"b_014","cardId":"c_001"}}

SC -> SC : verifie pas deja vote
SC -> SC : calcule poids (nb recos)
SC -> SC : enregistre le vote
SC -> SC : mine un bloc

SC -> S : {"status":"OK","action":"VOTE_REGISTERED"}
SC -> AC : {"status":"NOTIFY","action":"BATTLE_UPDATE"}

== Phase 3 : Resultat ==

SC -> SC : duree ecoulee (60s)
SC -> SC : determine gagnant (plus de votes)
SC -> SC : transfert 50% des recos
SC -> SC : incremente winCount gagnant
SC -> SC : si VA perdant = 0 -> INACTIVE
SC -> SC : mine un bloc final

SC -> AC : {"status":"NOTIFY","action":"BATTLE_RESULT"}
AC -> AC : Affichage du resultat

@enduml
