@startuml

title Sequence REQUEST_LEGITIMACY - Demander le statut legitime

actor "Utilisateur" as U
participant "CardController" as CC
participant "NetworkClient" as NC
participant "Serveur C" as SC
participant "Createur initial" as CR

U -> CC : clic Demander legitimation
CC -> NC : send REQUEST_LEGITIMACY
NC -> SC : {"action":"REQUEST_LEGITIMACY","payload":{"cardId":"c_001","justification":"..."}}

SC -> SC : verifie seuil (5 recos)
SC -> SC : mine un bloc

alt seuil atteint
    SC -> NC : {"status":"OK","action":"LEGITIMACY_REQUESTED","data":{"status":"PENDING"}}
    NC -> CC : callback
    CC -> U : Demande envoyee

    SC -> CR : Notifier le createur
    CR -> SC : Accepter / Refuser
    SC -> SC : mine un bloc

    alt acceptee
        SC -> NC : {"status":"NOTIFY","action":"LEGITIMACY_GRANTED"}
        NC -> CC : callback
        CC -> U : Vous etes legitime
    else refusee
        SC -> NC : {"status":"NOTIFY","action":"LEGITIMACY_REJECTED"}
        CC -> U : Demande refusee
    end

else seuil non atteint
    SC -> NC : {"status":"ERROR","code":"THRESHOLD_NOT_REACHED"}
    CC -> U : Message d'erreur
end

@enduml
