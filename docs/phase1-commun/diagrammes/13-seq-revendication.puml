@startuml

title Sequence CLAIM_CARD - Revendiquer une carte

actor "Utilisateur legitime" as U
participant "CardController" as CC
participant "NetworkClient" as NC
participant "Serveur C" as SC
participant "Proprietaire actuel" as PO

U -> CC : clic Revendiquer
CC -> NC : send CLAIM_CARD
NC -> SC : {"action":"CLAIM_CARD","payload":{"cardId":"c_001"}}

SC -> SC : verifie user legitime
SC -> SC : verifie proprietaire non legitime
SC -> SC : mine un bloc

alt revendication acceptee
    SC -> NC : {"status":"OK","action":"CARD_CLAIMED","data":{"newOwner":"u_003"}}
    NC -> CC : callback
    CC -> U : Carte revendiquee

    SC -> PO : {"status":"NOTIFY","action":"CARD_CLAIMED"}

else erreur
    SC -> NC : {"status":"ERROR","code":"NOT_LEGITIMATE"}
    CC -> U : Message d'erreur
end

@enduml
