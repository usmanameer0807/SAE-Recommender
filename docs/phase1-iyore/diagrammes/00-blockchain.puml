@startuml
skinparam classAttributeIconSize 0

title Structure de la Blockchain

class Block {
  + id : int
  + timestamp : long
  + data : char[1024]
  + prev_hash : char[65]
  + nonce : int
  + hash : char[65]
  --
  + compute_hash() : char[65]
  + mine(difficulty : int)
}

class Blockchain {
  + blocks : Block*
  + size : int
  + difficulty : int
  + mutex : pthread_mutex_t
  --
  + init()
  + add_block(Block)
  + mine_block(Block)
  + verify_chain() : bool
  + get_last_block() : Block*
}

class GenesisBlock {
  + id : int = 0
  + timestamp : long
  + data : "GENESIS"
  + prev_hash : "0000...0000"
  + nonce : int
  + hash : char[65]
}

Blockchain "1" *-- "*" Block : contient
Blockchain --> GenesisBlock : premier bloc

note right of Block
  hash = SHA-256(data + prev_hash + nonce)
end note

note right of Blockchain
  verify_chain() controle :
  - validite du hash
  - coherence prev_hash
  - preuve de travail
  - detection de modification
end note

@enduml
