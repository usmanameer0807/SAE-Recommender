@startuml

title Sequence VERIFICATION - Coherence de la blockchain

participant "Serveur C" as SC
participant "blockchain.c" as BC
participant "SHA-256" as SHA
participant "db.c" as DB
participant "PostgreSQL" as PG

SC -> BC : verify_chain()
BC -> DB : load_all_blocks()
DB -> PG : SELECT * FROM blocks ORDER BY id
PG --> DB : liste des blocs
DB --> BC : blocks

loop pour chaque bloc
    BC -> SHA : SHA-256(data + prev_hash + nonce)
    SHA --> BC : hash_calcule
    BC -> BC : verifie hash_calcule == hash_stocke
    alt hash invalide
        BC --> SC : BLOCKCHAIN_CORRUPTED
    end
    
    BC -> BC : verifie prev_hash == hash(bloc precedent)
    alt prev_hash invalide
        BC --> SC : BLOCKCHAIN_CORRUPTED
    end
    
    BC -> BC : verifie hash commence par N zeros
    alt preuve invalide
        BC --> SC : BLOCKCHAIN_CORRUPTED
    end
end

BC --> SC : BLOCKCHAIN_OK

@enduml
