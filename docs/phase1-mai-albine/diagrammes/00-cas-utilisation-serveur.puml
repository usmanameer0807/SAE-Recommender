@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

title Cas d'utilisation - Serveur C

actor "Client Java" as C
actor "Administrateur" as A
actor "Base de donnees" as DB

rectangle "Serveur C" {
  usecase "UC1 - Accepter connexion" as UC1
  usecase "UC2 - Recevoir requete" as UC2
  usecase "UC3 - Parser JSON" as UC3
  usecase "UC4 - Valider action" as UC4
  usecase "UC5 - Creer carte" as UC5
  usecase "UC6 - Recommander carte" as UC6
  usecase "UC7 - Repudier reco" as UC7
  usecase "UC8 - Lancer battle" as UC8
  usecase "UC9 - Voter battle" as UC9
  usecase "UC10 - Appliquer resultat battle" as UC10
  usecase "UC11 - Legitimation" as UC11
  usecase "UC12 - Authentification" as UC12
  usecase "UC13 - Revendication" as UC13
  usecase "UC14 - Miner un bloc" as UC14
  usecase "UC15 - Verifier blockchain" as UC15
  usecase "UC16 - Sauvegarder en BDD" as UC16
  usecase "UC17 - Restaurer contexte" as UC17
  usecase "UC18 - Liberer socket" as UC18
}

C --> UC1
C --> UC2
C --> UC5
C --> UC6
C --> UC7
C --> UC8
C --> UC9
C --> UC11
C --> UC12
C --> UC13
C --> UC18

A --> UC15
A --> UC17

UC2 ..> UC1 : <<include>>
UC3 ..> UC2 : <<include>>
UC4 ..> UC3 : <<include>>
UC5 ..> UC4 : <<include>>
UC6 ..> UC4 : <<include>>
UC7 ..> UC4 : <<include>>
UC8 ..> UC4 : <<include>>
UC9 ..> UC4 : <<include>>
UC10 ..> UC8 : <<extend>>
UC11 ..> UC4 : <<include>>
UC12 ..> UC4 : <<include>>
UC13 ..> UC4 : <<include>>

UC5 ..> UC14 : <<include>>
UC6 ..> UC14 : <<include>>
UC7 ..> UC14 : <<include>>
UC8 ..> UC14 : <<include>>
UC9 ..> UC14 : <<include>>
UC10 ..> UC14 : <<include>>
UC11 ..> UC14 : <<include>>
UC12 ..> UC14 : <<include>>
UC13 ..> UC14 : <<include>>

UC14 ..> UC16 : <<include>>
UC17 ..> DB

note right of UC14
  SHA-256
  Preuve de travail
end note

note right of UC16
  INSERT INTO blocks
  libpq
end note
@enduml
