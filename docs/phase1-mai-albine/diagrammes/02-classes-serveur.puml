@startuml
skinparam classAttributeIconSize 0

title Diagramme de classes - Serveur C

class Block {
  + id : int
  + timestamp : long
  + data : char[1024]
  + prev_hash : char[65]
  + nonce : int
  + hash : char[65]
}

class Blockchain {
  + blocks : Block*
  + size : int
  + difficulty : int
  + mutex : pthread_mutex_t
  --
  + add_block(Block)
  + verify_chain() : bool
  + mine_block(Block)
}

class Carte {
  + id : int
  + title : char[100]
  + paradigm : char[30]
  + creator_id : int
  + owner_id : int
  + status : char[20]
  + value : int
}

class Utilisateur {
  + id : int
  + username : char[50]
  + socket_fd : int
  + thread_id : pthread_t
  + connected : int
}

class Recommandation {
  + id : int
  + user_id : int
  + card_id : int
  + active : int
}

class Battle {
  + id : int
  + card1_id : int
  + card2_id : int
  + winner_id : int
  + status : int
}

class Vote {
  + id : int
  + battle_id : int
  + user_id : int
  + card_id : int
  + weight : int
}

class ClientThread {
  + socket_fd : int
  + user : Utilisateur*
  + handle_request()
  + send_response()
}

Blockchain "1" *-- "*" Block
ClientThread --> Blockchain
ClientThread --> Utilisateur
Blockchain --> Carte
Battle --> Vote
@enduml
