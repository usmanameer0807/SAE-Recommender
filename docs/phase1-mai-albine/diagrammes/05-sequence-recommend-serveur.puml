@startuml

title Sequence RECOMMEND - Cote serveur

participant "Socket" as S
participant "client_handler" as CH
participant "protocol" as P
participant "carte" as C
participant "blockchain" as BC
participant "db" as DB
participant "PostgreSQL" as PG

S -> CH : read() requete
CH -> P : parse_json()
P -> CH : action = "RECOMMEND"

CH -> C : recommend_card(user_id, card_id)
C -> C : verifie carte ACTIVE
C -> C : verifie pas deja recommandee
C -> C : value = value + 1
C -> BC : mine_block("ACTION_RECOMMEND")
BC -> DB : save_block_to_db()
DB -> PG : INSERT INTO blocks
PG --> DB : OK
BC --> C : OK

C -> DB : INSERT INTO recommendations
C -> DB : UPDATE cards SET value
DB -> PG : INSERT/UPDATE
PG --> DB : OK
DB --> C : OK

C --> CH : new_value
CH -> P : create_json_response()
P --> CH : {"status":"OK","action":"RECOMMENDATION_ADDED"}
CH -> S : send() reponse
CH -> S : broadcast CARD_UPDATED
@enduml
