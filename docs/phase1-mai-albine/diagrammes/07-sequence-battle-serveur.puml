@startuml

title Sequence BATTLE - Cote serveur

participant "Socket" as S
participant "client_handler" as CH
participant "protocol" as P
participant "battle" as B
participant "blockchain" as BC
participant "db" as DB
participant "PostgreSQL" as PG

S -> CH : read() requete
CH -> P : parse_json()
P -> CH : action = "START_BATTLE"

CH -> B : launch_battle(card1_id, card2_id)
B -> B : verifie cartes ACTIVE
B -> B : verifie meme paradigm
B -> B : verifie VA >= 5
B -> B : verifie 1 seule battle active
B -> B : genere battle_id
B -> BC : mine_block("ACTION_CREATE_BATTLE")
BC -> DB : save_block_to_db()
DB -> PG : INSERT INTO blocks
PG --> DB : OK

B -> DB : INSERT INTO battles
DB -> PG : INSERT
PG --> DB : OK
DB --> B : OK

B -> B : demarre timer 60s
B --> CH : battle_id
CH -> P : create_json_response()
P --> CH : {"status":"OK","action":"BATTLE_STARTED"}
CH -> S : send() reponse
CH -> S : broadcast NEW_BATTLE
@enduml
