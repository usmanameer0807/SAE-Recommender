@startuml

title Sequence VOTE_BATTLE - Cote serveur

participant "Socket" as S
participant "client_handler" as CH
participant "protocol" as P
participant "battle" as B
participant "blockchain" as BC
participant "db" as DB
participant "PostgreSQL" as PG

S -> CH : read() requete
CH -> P : parse_json()
P -> CH : action = "VOTE_BATTLE"

CH -> B : vote_battle(user_id, battle_id, card_id)
B -> B : verifie pas deja vote
B -> B : calcule poids (nb recos)
B -> B : enregistre le vote
B -> BC : mine_block("ACTION_VOTE_BATTLE")
BC -> DB : save_block_to_db()
DB -> PG : INSERT INTO blocks
PG --> DB : OK

B -> DB : INSERT INTO votes
DB -> PG : INSERT
PG --> DB : OK
DB --> B : OK

B --> CH : weight
CH -> P : create_json_response()
P --> CH : {"status":"OK","action":"VOTE_REGISTERED"}
CH -> S : send() reponse
CH -> S : broadcast BATTLE_UPDATE
@enduml
