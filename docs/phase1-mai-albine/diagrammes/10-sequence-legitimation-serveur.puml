@startuml

title Sequence REQUEST_LEGITIMACY - Cote serveur

participant "Socket" as S
participant "client_handler" as CH
participant "protocol" as P
participant "legitimation" as L
participant "blockchain" as BC
participant "db" as DB
participant "PostgreSQL" as PG

S -> CH : read() requete
CH -> P : parse_json()
P -> CH : action = "REQUEST_LEGITIMACY"

CH -> L : request_legitimation(user_id, card_id)
L -> L : verifie seuil (5 recos)
L -> BC : mine_block("ACTION_LEGITIMATE_USER")
BC -> DB : save_block_to_db()
DB -> PG : INSERT INTO blocks
PG --> DB : OK

L -> DB : INSERT INTO legitimacies
DB -> PG : INSERT
PG --> DB : OK
DB --> L : OK

L --> CH : legitimacy_id
CH -> P : create_json_response()
P --> CH : {"status":"OK","action":"LEGITIMACY_REQUESTED"}
CH -> S : send() reponse
CH -> S : notifier le createur
@enduml
