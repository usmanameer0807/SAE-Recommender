@startuml

title Sequence DISCONNECT - Cote serveur

participant "Socket" as S
participant "client_handler" as CH
participant "protocol" as P
participant "blockchain" as BC
participant "db" as DB
participant "PostgreSQL" as PG
participant "Autres clients" as AC

S -> CH : read() requete
CH -> P : parse_json()
P -> CH : action = "DISCONNECT"

CH -> CH : libere la socket
CH -> DB : sauvegarde les blocs en attente
DB -> PG : INSERT INTO blocks
PG --> DB : OK
DB --> CH : OK

CH -> P : create_json_response()
P --> CH : {"status":"OK","action":"DISCONNECTED"}
CH -> S : send() reponse

CH -> S : close() socket
CH -> AC : broadcast USER_DISCONNECTED
AC -> AC : retire de la liste
@enduml
