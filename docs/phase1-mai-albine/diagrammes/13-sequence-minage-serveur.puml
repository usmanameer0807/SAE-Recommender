@startuml

title Sequence MINAGE - Preuve de travail

participant "Serveur C" as SC
participant "blockchain.c" as BC
participant "SHA-256" as SHA
participant "db.c" as DB
participant "PostgreSQL" as PG

SC -> BC : mine_block(data)
BC -> BC : cree nouveau bloc
BC -> BC : nonce = 0

loop jusqu'a hash valide
    BC -> SHA : SHA-256(data + prev_hash + nonce)
    SHA --> BC : hash
    BC -> BC : verifie si hash commence par N zeros
    alt hash invalide
        BC -> BC : nonce = nonce + 1
    else hash valide
        BC -> BC : bloc mine
    end
end

BC -> BC : ajoute bloc a la chaine
BC -> DB : save_block_to_db(block)
DB -> PG : INSERT INTO blocks
PG --> DB : OK
DB --> BC : OK
BC --> SC : bloc ajoute
@enduml
