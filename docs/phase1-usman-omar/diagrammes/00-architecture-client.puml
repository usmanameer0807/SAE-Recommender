@startuml
skinparam componentStyle rectangle
skinparam defaultFontSize 12

title Architecture du Client JavaFX

package "Client JavaFX" {
  package "Couche 1 - Vue (FXML + CSS)" {
    [login.fxml]
    [main.fxml]
    [cards.fxml]
    [card_view.fxml]
    [create_card.fxml]
    [battles.fxml]
    [profile.fxml]
  }
  package "Couche 2 - Controleurs (Java)" {
    [LoginController]
    [MainController]
    [CardController]
    [CardViewController]
    [CreateCardController]
    [BattleController]
  }
  package "Couche 3 - Reseau" {
    [NetworkClient]
  }
  package "Couche 4 - Modele" {
    [Card]
    [User]
    [Recommendation]
    [Battle]
    [Vote]
    [Legitimacy]
    [Request]
    [Response]
  }
  package "Couche 5 - Serialisation" {
    [Gson]
  }
}
component "Serveur C" as SRV
[login.fxml] --> [LoginController]
[main.fxml] --> [MainController]
[cards.fxml] --> [CardController]
[LoginController] --> [NetworkClient]
[CardController] --> [NetworkClient]
[NetworkClient] --> [Request]
[NetworkClient] --> [Response]
[NetworkClient] --> [Gson]
[NetworkClient] --> SRV
@enduml
