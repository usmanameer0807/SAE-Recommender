@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

title Cas d'utilisation - Client JavaFX

actor "Utilisateur" as U
actor "Bot" as B
actor "Serveur C" as S

rectangle "Client JavaFX" {
  usecase "UC1 - Se connecter" as UC1
  usecase "UC2 - Voir cartes" as UC2
  usecase "UC3 - Creer carte" as UC3
  usecase "UC4 - Recommander" as UC4
  usecase "UC5 - Repudier" as UC5
  usecase "UC6 - Lancer battle" as UC6
  usecase "UC7 - Voter battle" as UC7
  usecase "UC8 - Demander legitimation" as UC8
  usecase "UC9 - Authentifier carte" as UC9
  usecase "UC10 - Revendiquer carte" as UC10
  usecase "UC11 - Voir utilisateurs" as UC11
  usecase "UC12 - Se deconnecter" as UC12
}

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5
U --> UC6
U --> UC7
U --> UC8
U --> UC9
U --> UC10
U --> UC11
U --> UC12

B --> UC1
B --> UC2
B --> UC3
B --> UC4
B --> UC7

UC2 ..> UC1 : <<include>>
UC3 ..> UC1 : <<include>>
UC4 ..> UC1 : <<include>>
UC5 ..> UC1 : <<include>>
UC6 ..> UC1 : <<include>>
UC7 ..> UC1 : <<include>>
UC8 ..> UC1 : <<include>>
UC9 ..> UC1 : <<include>>
UC10 ..> UC1 : <<include>>

UC9 ..> UC8 : <<extend>>
UC10 ..> UC8 : <<extend>>

UC1 --> S
@enduml
