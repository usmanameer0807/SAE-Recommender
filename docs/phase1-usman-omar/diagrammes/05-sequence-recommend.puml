@startuml

title Sequence RECOMMEND

actor Utilisateur
participant "CardController" as CC
participant "NetworkClient" as NC
participant "Serveur C" as SC
participant "Autres clients" as AC

Utilisateur -> CC : clic Recommander
CC -> NC : send RECOMMEND
NC -> SC : {"action":"RECOMMEND"}

SC -> SC : value = value + 1
SC -> SC : mine un bloc

alt succes
    SC -> NC : {"status":"OK","action":"RECOMMENDATION_ADDED"}
    SC -> AC : {"status":"NOTIFY","action":"CARD_UPDATED"}
    NC -> CC : callback
    CC -> Utilisateur : valeur mise a jour
else carte inactive
    SC -> NC : {"status":"ERROR","code":"CARD_NOT_ACTIVE"}
    NC -> CC : callback
    CC -> Utilisateur : Message d'erreur
end
@enduml
