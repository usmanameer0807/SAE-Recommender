@startuml

title Sequence REPUDIATE

actor Utilisateur
participant "CardController" as CC
participant "NetworkClient" as NC
participant "Serveur C" as SC

Utilisateur -> CC : clic Repudier
CC -> NC : send REPUDIATE
NC -> SC : {"action":"REPUDIATE"}

SC -> SC : value = value - 1
SC -> SC : mine un bloc

alt succes
    SC -> NC : {"status":"OK","action":"RECOMMENDATION_REPUDIATED"}
    NC -> CC : callback
    CC -> Utilisateur : valeur mise a jour
else pas de reco
    SC -> NC : {"status":"ERROR","code":"NOT_RECOMMENDED"}
    NC -> CC : callback
    CC -> Utilisateur : Message d'erreur
end
@enduml
