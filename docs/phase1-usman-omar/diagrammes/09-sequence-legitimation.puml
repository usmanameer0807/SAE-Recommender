@startuml

title Sequence REQUEST_LEGITIMACY

actor "Utilisateur" as U
participant "CardController" as CC
participant "NetworkClient" as NC
participant "Serveur C" as SC

U -> CC : clic Demander legitimation
CC -> NC : send REQUEST_LEGITIMACY
NC -> SC : {"action":"REQUEST_LEGITIMACY"}

SC -> SC : verifie seuil (5 recos)
SC -> SC : mine un bloc

alt seuil atteint
    SC -> NC : {"status":"OK","action":"LEGITIMACY_REQUESTED"}
    NC -> CC : callback
    CC -> U : Demande envoyee
else seuil non atteint
    SC -> NC : {"status":"ERROR","code":"THRESHOLD_NOT_REACHED"}
    NC -> CC : callback
    CC -> U : Message d'erreur
end
@enduml
