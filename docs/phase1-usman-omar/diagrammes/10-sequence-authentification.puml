@startuml

title Sequence AUTHENTICATE_CARD

actor "Utilisateur legitime" as U
participant "CardController" as CC
participant "NetworkClient" as NC
participant "Serveur C" as SC

U -> CC : clic Authentifier
CC -> NC : send AUTHENTICATE_CARD
NC -> SC : {"action":"AUTHENTICATE_CARD"}

SC -> SC : verifie user legitime
SC -> SC : value = value + 10
SC -> SC : mine un bloc

alt succes
    SC -> NC : {"status":"OK","action":"CARD_AUTHENTICATED"}
    NC -> CC : callback
    CC -> U : Carte authentifiee (+10 VA)
else pas legitime
    SC -> NC : {"status":"ERROR","code":"NOT_LEGITIMATE"}
    NC -> CC : callback
    CC -> U : Message d'erreur
end
@enduml
